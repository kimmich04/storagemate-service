# Copy thành .env rồi điền. KHÔNG commit .env
ZALO_BOT_TOKEN=123456789:xxxxxxxx
ZALO_WEBHOOK_SECRET=<chuoi ngau nhien >= 32 ky tu>
PUBLIC_BASE_URL=https://<ten-ban>.ngrok-free.app
DATABASE_URL=postgresql+psycopg://storagemate:storagemate@localhost:5432/storagemate
DATABASE_URL_READONLY=postgresql+psycopg://qa_reader:***@localhost:5432/storagemate
JWT_SECRET=<chuoi ngau nhien>
GEMINI_API_KEY=
LLM_MODEL=<ten model Gemini Flash-Lite trong AI Studio>
HF_MODEL_REPO=<user>/storagemate-ner
NER_MODEL_PATH=models/ner/model_quantized.onnx
TZ=Asia/Ho_Chi_Minh
CORS_ORIGINS=http://localhost:5173,https://<app>.vercel.app
LLM_TIMEOUT_SECONDS=15
PENDING_TTL_MINUTES=10
