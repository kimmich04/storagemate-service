{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "npx -y ccusage@latest statusline"
  },
  "permissions": {
    "allow": [
      "Read", "Edit", "Write",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)",
      "Bash(graphify query:*)", "Bash(graphify explain:*)", "Bash(graphify path:*)",
      "Bash(pytest:*)", "Bash(python -m pytest:*)",
      "Bash(ruff check:*)", "Bash(ruff format:*)",
      "Bash(alembic history:*)", "Bash(alembic current:*)", "Bash(alembic check:*)",
      "Bash(docker compose ps:*)", "Bash(docker compose logs:*)"
    ],
    "ask": [
      "Bash(git push:*)", "Bash(git commit:*)", "Bash(rm:*)",
      "Bash(alembic upgrade:*)", "Bash(alembic downgrade:*)", "Bash(alembic revision:*)",
      "Bash(docker compose up:*)", "Bash(docker compose down:*)",
      "Bash(python scripts/zalo_set_webhook.py:*)", "Bash(python scripts/create_admin.py:*)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Edit(./.env)", "Bash(cat .env:*)"
    ]
  }
}
